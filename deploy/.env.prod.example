# Production environment for deploy/docker-compose.prod.yml.
# Copy to deploy/.env.prod (git-ignored), fill it in, then: chmod 600 deploy/.env.prod
# Read by `docker compose --env-file deploy/.env.prod ...`: values may be quoted
# or not, but never commit the real file. Guide: docs/DEPLOY-ORACLE.md
# Every value below is a placeholder.

# --- Domains (DNS A records pointing to the VM public IP) ---------------------
APP_DOMAIN=app.example.org
API_DOMAIN=api.example.org
TURN_DOMAIN=turn.example.org
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.org

# Path to the web repo, relative to deploy/ (default: sibling clone).
WEB_CONTEXT=../../frontend-steam-society

# --- PostgreSQL (container on the same VM, not exposed) -----------------------
POSTGRES_USER=steam
# Use only letters and digits (it goes inside a URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me-hex-only
POSTGRES_DB=steam_society
# Leave commented to use the local container. For Neon (alternative), set the
# full URL Neon gives you (keep ?sslmode=require):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example.sa-east-1.aws.neon.tech/DB?sslmode=require&schema=public

# --- API secrets ----------------------------------------------------------------
# Min 32 chars: openssl rand -base64 48
SESSION_SECRET=change-me-at-least-32-characters-long-placeholder
# 32 bytes in base64: openssl rand -base64 32   (back it up apart from the DB!)
MFA_ENCRYPTION_KEY=change-me-base64-32-bytes

# --- E-mail (Brevo SMTP) --------------------------------------------------------
# smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587  (URL-encode special characters)
SMTP_URL=smtp://login%40example.org:change-me-brevo-smtp-key@smtp-relay.brevo.com:587
SMTP_FROM=Steam Society <no-reply@example.org>
EMAIL_DISPATCH_INTERVAL_MS=10000

# --- Business settings (defaults shown) ----------------------------------------
BOOKING_REQUEST_TTL_HOURS=48
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_BREACH_CHECK=hibp
PAYMENTS_PROVIDER=disabled
PAYMENTS_FEE_BPS=1500

# --- Video calls (WebRTC) -------------------------------------------------------
CALL_STUN_URLS=stun:stun.cloudflare.com:3478
# Self-hosted coturn on this VM (TURN REST shared secret): openssl rand -hex 32
# coturn uses it today; the API adapter that turns it into temporary
# credentials is PENDING (adaptador de la API pendiente).
CALL_TURN_SHARED_SECRET=change-me-openssl-rand-hex-32-at-least-32-chars
CALL_TURN_URLS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp,turns:turn.example.org:5349?transport=tcp
# VM addresses for coturn's NAT mapping (Oracle: public IP / private VNIC IP).
TURN_PUBLIC_IP=203.0.113.10
TURN_PRIVATE_IP=10.0.0.10
# Optional alternative already supported by the API: Cloudflare Realtime TURN.
# CALL_TURN_KEY_ID=
# CALL_TURN_API_TOKEN=

# --- Backups (deploy/backup.sh) -------------------------------------------------
BACKUP_HOST_DIR=/var/backups/steam
BACKUP_KEEP=14
# rclone remote for the off-VM copy, e.g. oci:steam-backups (empty = skip).
BACKUP_RCLONE_REMOTE=
