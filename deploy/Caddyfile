# Caddy: automatic HTTPS (Let's Encrypt) and reverse proxy.
# Hostnames come from the environment (deploy/.env.prod): APP_DOMAIN, API_DOMAIN,
# TURN_DOMAIN, ACME_EMAIL. Guide: docs/DEPLOY-ORACLE.md

{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Web (Next.js standalone)
{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy web:3001
}

# API (NestJS). No `encode` here and `flush_interval -1`: the call signaling
# stream GET /v1/bookings/:id/call/events is Server-Sent Events and must reach
# the browser immediately, without buffering.
{$API_DOMAIN} {
	import security_headers
	reverse_proxy api:3000 {
		flush_interval -1
	}
}

# Only so Caddy obtains (and renews) a certificate for the TURN host; coturn
# reads it from Caddy's data volume for TURN over TLS (port 5349).
{$TURN_DOMAIN} {
	import security_headers
	respond "ok" 200
}
