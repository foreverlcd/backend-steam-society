generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Area {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String           @unique
  parentId        String?          @map("parent_id") @db.Uuid
  parent          Area?            @relation("AreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Area[]           @relation("AreaHierarchy")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  mentorAreas     MentorArea[]
  menteeInterests MenteeInterest[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "area_name_trgm_idx", type: Gin)
  @@map("area")
}

enum UserRole {
  mentee
  mentor
  admin

  @@map("user_role")
}

enum UserStatus {
  pending_verification
  active
  suspended
  deleted

  @@map("user_status")
}

model User {
  id                  String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email               String               @unique
  passwordHash        String?              @map("password_hash")
  role                UserRole
  status              UserStatus           @default(active)
  firstName           String?              @map("first_name")
  lastName            String?              @map("last_name")
  birthDate           DateTime?            @map("birth_date") @db.Date
  timezone            String               @default("America/Lima")
  locale              String               @default("es")
  emailVerifiedAt     DateTime?            @map("email_verified_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  passwordResetTokens PasswordResetToken[]
  mentorProfile       MentorProfile?       @relation("MentorProfile")
  menteeProfile       MenteeProfile?       @relation("MenteeProfile")
  reviewedProfiles    MentorProfile[]      @relation("MentorReviewer")
  onboardingResponses OnboardingResponse[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  availabilityRules   AvailabilityRule[]

  @@map("user")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_token")
}

model AuthSession {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("auth_session")
}

enum MentorStatus {
  draft
  pending_review
  approved
  rejected
  suspended

  @@map("mentor_status")
}

enum EducationLevel {
  school
  undergraduate
  graduate
  career_change
  other

  @@map("education_level")
}

enum CareerStage {
  school
  preuniversity
  university
  early_career

  @@map("career_stage")
}

enum OfferingType {
  one_to_one
  group

  @@map("offering_type")
}

enum SessionStatus {
  open
  cancelled
  completed

  @@map("session_status")
}

enum BookingStatus {
  requested
  awaiting_payment
  confirmed
  declined
  cancelled
  expired
  completed
  no_show

  @@map("booking_status")
}

enum CancelActor {
  mentee
  mentor
  admin
  system

  @@map("cancel_actor")
}

enum NoShowParty {
  mentee
  mentor

  @@map("no_show_party")
}

model Language {
  code            String           @id @db.VarChar(2)
  name            String
  mentorLanguages MentorLanguage[]
  menteeLanguages MenteeLanguage[]

  @@map("language")
}

model MentorProfile {
  userId          String                   @id @map("user_id") @db.Uuid
  user            User                     @relation("MentorProfile", fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  bio             String?
  searchVector    Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('spanish'::regconfig, COALESCE(headline, ''::text)), 'A'::\"char\") || setweight(to_tsvector('spanish'::regconfig, COALESCE(bio, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('spanish'::regconfig, COALESCE(city, ''::text)), 'C'::\"char\"))")) @map("search_vector")
  yearsExperience Int?                     @map("years_experience")
  country         String?                  @db.VarChar(2)
  city            String?
  status          MentorStatus             @default(draft)
  reviewedBy      String?                  @map("reviewed_by") @db.Uuid
  reviewer        User?                    @relation("MentorReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?                @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?                  @map("rejection_reason")
  minNoticeHours  Int                      @default(24) @map("min_notice_hours")
  maxAdvanceDays  Int                      @default(60) @map("max_advance_days")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  areas           MentorArea[]
  languages       MentorLanguage[]
  offerings       Offering[]
  sessions        Session[]

  @@index([status])
  @@index([bio(ops: raw("gin_trgm_ops"))], map: "mentor_profile_bio_trgm_idx", type: Gin)
  @@index([city(ops: raw("gin_trgm_ops"))], map: "mentor_profile_city_trgm_idx", type: Gin)
  @@index([headline(ops: raw("gin_trgm_ops"))], map: "mentor_profile_headline_trgm_idx", type: Gin)
  @@index([searchVector], type: Gin)
  @@map("mentor_profile")
}

model MenteeProfile {
  userId         String           @id @map("user_id") @db.Uuid
  user           User             @relation("MenteeProfile", fields: [userId], references: [id], onDelete: Cascade)
  goals          String?
  educationLevel EducationLevel?  @map("education_level")
  careerStage    CareerStage?     @map("career_stage")
  country        String?          @db.VarChar(2)
  city           String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  interests      MenteeInterest[]
  languages      MenteeLanguage[]
  bookings       Booking[]

  @@map("mentee_profile")
}

model MentorArea {
  mentorId String        @map("mentor_id") @db.Uuid
  areaId   String        @map("area_id") @db.Uuid
  mentor   MentorProfile @relation(fields: [mentorId], references: [userId], onDelete: Cascade)
  area     Area          @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@id([mentorId, areaId])
  @@index([areaId])
  @@map("mentor_area")
}

model MenteeInterest {
  menteeId String        @map("mentee_id") @db.Uuid
  areaId   String        @map("area_id") @db.Uuid
  mentee   MenteeProfile @relation(fields: [menteeId], references: [userId], onDelete: Cascade)
  area     Area          @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@id([menteeId, areaId])
  @@index([areaId])
  @@map("mentee_interest")
}

model MentorLanguage {
  mentorId     String        @map("mentor_id") @db.Uuid
  languageCode String        @map("language_code") @db.VarChar(2)
  mentor       MentorProfile @relation(fields: [mentorId], references: [userId], onDelete: Cascade)
  language     Language      @relation(fields: [languageCode], references: [code], onDelete: Restrict)

  @@id([mentorId, languageCode])
  @@index([languageCode])
  @@map("mentor_language")
}

model MenteeLanguage {
  menteeId     String        @map("mentee_id") @db.Uuid
  languageCode String        @map("language_code") @db.VarChar(2)
  mentee       MenteeProfile @relation(fields: [menteeId], references: [userId], onDelete: Cascade)
  language     Language      @relation(fields: [languageCode], references: [code], onDelete: Restrict)

  @@id([menteeId, languageCode])
  @@index([languageCode])
  @@map("mentee_language")
}

model OnboardingResponse {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionCode String   @map("question_code")
  answer       Json     @db.JsonB
  version      Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, questionCode])
  @@index([userId])
  @@map("onboarding_response")
}

model AuditLog {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_log")
}

model AvailabilityRule {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime DateTime  @map("start_time") @db.Time(0)
  endTime   DateTime  @map("end_time") @db.Time(0)
  timezone  String    @db.VarChar(64)
  validFrom DateTime? @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, weekday])
  @@map("availability_rule")
}

model Offering {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  mentorId        String        @map("mentor_id") @db.Uuid
  mentor          MentorProfile @relation(fields: [mentorId], references: [userId], onDelete: Cascade)
  title           String
  description     String?
  type            OfferingType  @default(one_to_one)
  durationMinutes Int           @map("duration_minutes")
  capacity        Int           @default(1)
  isFree          Boolean       @map("is_free")
  priceMinor      Int           @map("price_minor")
  currency        String        @db.VarChar(3)
  active          Boolean       @default(true)
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        Session[]

  @@index([mentorId, active])
  @@map("offering")
}

model Session {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  offeringId String        @map("offering_id") @db.Uuid
  offering   Offering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  mentorId   String        @map("mentor_id") @db.Uuid
  mentor     MentorProfile @relation(fields: [mentorId], references: [userId], onDelete: Restrict)
  startsAt   DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime      @map("ends_at") @db.Timestamptz(3)
  capacity   Int
  status     SessionStatus @default(open)
  meetingUrl String?       @map("meeting_url")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  bookings   Booking[]

  @@index([mentorId, startsAt])
  @@map("session")
}

model Booking {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId       String        @map("session_id") @db.Uuid
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  menteeId        String        @map("mentee_id") @db.Uuid
  mentee          MenteeProfile @relation(fields: [menteeId], references: [userId], onDelete: Restrict)
  status          BookingStatus @default(requested)
  message         String?
  requestedAt     DateTime      @default(now()) @map("requested_at") @db.Timestamptz(3)
  respondedAt     DateTime?     @map("responded_at") @db.Timestamptz(3)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy     CancelActor?  @map("cancelled_by")
  cancelReason    String?       @map("cancel_reason")
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)
  noShowParty     NoShowParty?  @map("no_show_party")
  paymentRequired Boolean       @map("payment_required")
  priceMinor      Int           @map("price_minor")
  currency        String        @db.VarChar(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([menteeId, status])
  @@index([sessionId, status])
  @@map("booking")
}
