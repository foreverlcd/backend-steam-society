{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    { "action": "shell", "resource": "git merge *", "effect": "allow" },
    { "action": "shell", "resource": "git tag backup/*", "effect": "allow" },
    { "action": "shell", "resource": "git push origin *", "effect": "allow" },
    { "action": "shell", "resource": "git push upstream *", "effect": "allow" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git push * :*", "effect": "deny" },
    { "action": "shell", "resource": "git push * +*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --tags*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },

    { "action": "shell", "resource": "pnpm install *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm add *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm remove *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm update *", "effect": "allow" },
    { "action": "shell", "resource": "*.sh*", "effect": "allow" },
    { "action": "*", "resource": "*.sh*", "effect": "*" },

    { "action": "shell", "resource": "pnpm test *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm build", "effect": "allow" },
    { "action": "shell", "resource": "pnpm lint *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm db:validate", "effect": "allow" },
    { "action": "shell", "resource": "pnpm db:generate", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ps *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "docker compose logs *",
      "effect": "allow"
    },
    { "action": "shell", "resource": "pnpm test:e2e", "effect": "allow" },
    { "action": "shell", "resource": "pnpm format", "effect": "allow" },
    { "action": "shell", "resource": "pnpm format:check", "effect": "allow" },
    {
      "action": "shell",
      "resource": "pnpm exec prisma migrate dev *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm exec prisma migrate deploy",
      "effect": "allow"
    },
    { "action": "shell", "resource": "docker compose up *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "docker compose start *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose stop *",
      "effect": "allow"
    },

    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "docker compose down *",
      "effect": "deny"
    },
    { "action": "skill", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "find-skills", "effect": "deny" },
    { "action": "skill", "resource": "caveman*", "effect": "deny" },
    { "action": "skill", "resource": "shadcn", "effect": "deny" },
    {
      "action": "skill",
      "resource": "migrate-radix-to-base",
      "effect": "deny"
    },
    { "action": "skill", "resource": "prisma-client-api", "effect": "allow" },
    {
      "action": "skill",
      "resource": "postgres-best-practices",
      "effect": "ask"
    }
  ]
}
