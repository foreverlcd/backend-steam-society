POSTGRES_USER=steam
POSTGRES_PASSWORD=cambia_esto_local
POSTGRES_DB=steam_society

# Conexión de Prisma (puerto publicado por docker-compose)
DATABASE_URL="postgresql://steam:cambia_esto_local@127.0.0.1:5433/steam_society?schema=public"

# Orígenes permitidos por CORS, separados por coma (vacío = CORS desactivado)
WEB_ORIGIN="http://localhost:3001"

# Secreto de sesión: mínimo 32 caracteres. Genera uno con `openssl rand -base64 48`.
SESSION_SECRET="cambia_esto_por_un_secreto_de_al_menos_32_caracteres"

# `false` solo en desarrollo local sobre HTTP. En producción debe ser `true`
# (cookie __Host-sid, Secure, HttpOnly, SameSite=Lax).
SESSION_COOKIE_SECURE=false

# URL del frontend usada en el enlace de recuperación de contraseña.
APP_URL="http://localhost:3001"

# Plazo de respuesta de una solicitud de reserva, en horas (R-06, ADR-021).
# Entero positivo; 48 por defecto.
BOOKING_REQUEST_TTL_HOURS=48

# SMTP local para desarrollo (Mailpit). El proveedor transaccional sigue
# pendiente en P-05.
SMTP_URL="smtp://127.0.0.1:1025"
SMTP_FROM="Steam Society <no-reply@steamsociety.local>"
# Cada cuánto el despachador envía los correos de la cola (ms). 0 lo apaga.
EMAIL_DISPATCH_INTERVAL_MS=10000

# Credenciales del admin inicial (solo para `pnpm db:seed`; nunca se versionan).
ADMIN_EMAIL="admin@steamsociety.local"
ADMIN_PASSWORD="cambia_esto_12_caracteres"

# Pagos (módulo desacoplado). `disabled` en el piloto (solo mentorías
# gratuitas); `fake` simula el checkout en desarrollo y está prohibido con
# NODE_ENV=production. Un proveedor real se añade como adaptador nuevo.
PAYMENTS_PROVIDER=disabled
# Comisión de la plataforma en puntos básicos (1500 = 15 %, provisional F0).
PAYMENTS_FEE_BPS=1500

# Contraseña de las cuentas demo ficticias (`pnpm db:seed:demo`); mínimo 12.
DEMO_PASSWORD="cambia_esto_demo_12"

# Verificación de correo y 2FA (ADR-024)
# Horas de validez del enlace de verificación de correo.
EMAIL_VERIFICATION_TTL_HOURS=48
# Clave que cifra los secretos TOTP (2FA): 32 bytes en base64.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obligatoria en producción; en desarrollo, si falta, se deriva de SESSION_SECRET.
# MFA_ENCRYPTION_KEY=

# Rechazar contraseñas filtradas (Have I Been Pwned, gratis, k-anonimato: solo
# salen 5 caracteres del hash SHA-1). "off" | "hibp". Recomendado "hibp" en producción.
PASSWORD_BREACH_CHECK=off
