POSTGRES_USER=steam
POSTGRES_PASSWORD=cambia_esto_local
POSTGRES_DB=steam_society

# Conexión de Prisma (puerto publicado por docker-compose)
DATABASE_URL="postgresql://steam:cambia_esto_local@127.0.0.1:5433/steam_society?schema=public"

# Orígenes permitidos por CORS, separados por coma (vacío = CORS desactivado)
WEB_ORIGIN="http://localhost:3001"

# Secreto de sesión: mínimo 32 caracteres. Genera uno con `openssl rand -base64 48`.
SESSION_SECRET="cambia_esto_por_un_secreto_de_al_menos_32_caracteres"

# `false` solo en desarrollo local sobre HTTP. En producción debe ser `true`
# (cookie __Host-sid, Secure, HttpOnly, SameSite=Lax).
SESSION_COOKIE_SECURE=false

# URL del frontend usada en el enlace de recuperación de contraseña.
APP_URL="http://localhost:3001"

# SMTP local para desarrollo (Mailpit). El proveedor transaccional sigue
# pendiente en P-05.
SMTP_URL="smtp://127.0.0.1:1025"
SMTP_FROM="Steam Society <no-reply@steamsociety.local>"

# Credenciales del admin inicial (solo para `pnpm db:seed`; nunca se versionan).
ADMIN_EMAIL="admin@steamsociety.local"
ADMIN_PASSWORD="cambia_esto_12_caracteres"
